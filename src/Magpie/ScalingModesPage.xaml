<Page x:Class="Magpie.ScalingModesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:Magpie"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      mc:Ignorable="d">
	<Page.Resources>
		<Style x:Key="ScalingModesHeaderButtonStyle" TargetType="Button"
		       BasedOn="{StaticResource DefaultButtonStyle}">
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="Height" Value="{StaticResource PaneToggleButtonHeight}" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style x:Key="EffectPickerPresenterStyle" TargetType="FlyoutPresenter"
		       BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
			<Setter Property="MaxWidth" Value="1000" />
			<Setter Property="MaxHeight" Value="900" />
			<Setter Property="Padding" Value="4" />
		</Style>
		<Style x:Key="EffectParametersPresenterStyle" TargetType="FlyoutPresenter"
		       BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
			<Setter Property="MaxWidth" Value="10000" />
			<Setter Property="MaxHeight" Value="10000" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="FlyoutPresenter">
						<!-- A single-page parameter surface does not need the default
						     focusable ScrollViewer around its content. -->
						<Border Background="{TemplateBinding Background}" BackgroundSizing="OuterBorderEdge"
						        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="{TemplateBinding CornerRadius}" Padding="{ThemeResource FlyoutBorderThemePadding}">
							<ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
							                  ContentTransitions="{TemplateBinding ContentTransitions}" Margin="{TemplateBinding Padding}"
							                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="EffectPickerButtonStyle" TargetType="Button"
		       BasedOn="{StaticResource DefaultButtonStyle}">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="10,8" />
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		</Style>
		<Style x:Key="EffectPickerLetterButtonStyle" TargetType="Button"
		       BasedOn="{StaticResource EffectPickerButtonStyle}">
			<Setter Property="Width" Value="18" />
			<Setter Property="Height" Value="18" />
			<Setter Property="FontSize" Value="10" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="UseSystemFocusVisuals" Value="True" />
			<Setter Property="FocusVisualMargin" Value="0" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid x:Name="LetterRoot" Background="{TemplateBinding Background}"
						      CornerRadius="{TemplateBinding CornerRadius}">
							<VisualStateManager.VisualStateGroups>
								<VisualStateGroup x:Name="CommonStates">
									<VisualState x:Name="Normal" />
									<VisualState x:Name="PointerOver">
										<VisualState.Setters>
											<Setter Target="LetterRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
										</VisualState.Setters>
									</VisualState>
									<VisualState x:Name="Pressed">
										<VisualState.Setters>
											<Setter Target="LetterRoot.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
										</VisualState.Setters>
									</VisualState>
									<VisualState x:Name="Disabled">
										<VisualState.Setters>
											<Setter Target="LetterContent.Opacity" Value="0.3" />
										</VisualState.Setters>
									</VisualState>
								</VisualStateGroup>
							</VisualStateManager.VisualStateGroups>
							<ContentPresenter x:Name="LetterContent"
							                  Content="{TemplateBinding Content}"
							                  ContentTemplate="{TemplateBinding ContentTemplate}"
							                  Foreground="{TemplateBinding Foreground}"
							                  FontFamily="{TemplateBinding FontFamily}"
							                  FontSize="{TemplateBinding FontSize}"
							                  FontWeight="{TemplateBinding FontWeight}"
							                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<SolidColorBrush x:Key="EffectPickerCategoryBackground" Color="{ThemeResource SystemBaseHighColor}" Opacity="0.025" />
		<SolidColorBrush x:Key="EffectPickerListBackground" Color="{ThemeResource SystemBaseHighColor}" Opacity="0.06" />
		<SolidColorBrush x:Key="EffectPickerDetailBackground" Color="{ThemeResource SystemBaseHighColor}" Opacity="0.10" />
		<Style x:Key="EffectPickerPaneStyle" TargetType="Border">
			<Setter Property="Background" Value="{ThemeResource EffectPickerListBackground}" />
			<Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
			<Setter Property="CornerRadius" Value="4" />
		</Style>
		<Style x:Key="EffectPickerCategoryPaneStyle" TargetType="Border"
		       BasedOn="{StaticResource EffectPickerPaneStyle}">
			<Setter Property="Background" Value="{ThemeResource EffectPickerCategoryBackground}" />
		</Style>
		<Style x:Key="EffectPickerDetailPaneStyle" TargetType="Border"
		       BasedOn="{StaticResource EffectPickerPaneStyle}">
			<Setter Property="Background" Value="{ThemeResource EffectPickerDetailBackground}" />
		</Style>
		<Style x:Key="EffectPickerCategoryStyle" TargetType="Border">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
			<Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
		</Style>
		<Style x:Key="EffectPickerSelectedCategoryStyle" TargetType="Border"
		       BasedOn="{StaticResource EffectPickerCategoryStyle}">
			<Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
		</Style>
		<DataTemplate x:Key="EffectPickerSelectionMark">
			<Border Width="3" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
			        Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.5" />
		</DataTemplate>
		<DataTemplate x:Key="EffectParametersFlyout"
                      x:DataType="local:EffectParametersViewModel">
            <Grid MaxHeight="{x:Bind ContentMaxHeight, Mode=OneWay}" MaxWidth="{x:Bind ContentWidth, Mode=OneWay}"
                  HorizontalAlignment="Left" VerticalAlignment="Top" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ValidationMessage, Mode=OneWay}" TextWrapping="Wrap"
                           Visibility="{x:Bind HasValidationMessage, Mode=OneWay}" />
                <Grid Grid.Row="1">
                <local:SimpleStackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <local:SimpleStackPanel Width="260" Spacing="8" VerticalAlignment="Top" Visibility="{x:Bind IsOKLab}">
                        <ComboBox x:Uid="OKLabUI_Section" Width="260" HorizontalAlignment="Left"
                        Visibility="{x:Bind IsOKLab}" ItemsSource="{x:Bind OKSections}"
                        SelectedIndex="{x:Bind OKSection, Mode=TwoWay}"  />
                        <Border Height="1" Margin="0,8" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.45" />
                        <ComboBox x:Uid="OKLabUI_Preset" ItemsSource="{x:Bind OKPresets}" SelectedIndex="{x:Bind OKPreset, Mode=TwoWay}" Width="260"  />
                        <Button HorizontalAlignment="Stretch" x:Uid="OKLabUI_ApplyPreset" Click="{x:Bind OKApplyPreset}" />
                        <Border Height="1" Margin="0,8" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.45" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button HorizontalAlignment="Stretch" x:Uid="OKLabUI_ResetGroup" Click="{x:Bind OKResetGroup}" />
                            <Button Grid.Column="1" HorizontalAlignment="Stretch" x:Uid="OKLabUI_ResetAll" Click="{x:Bind OKResetAll}" />
                        </Grid>
                        <Grid ColumnSpacing="8" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button HorizontalAlignment="Stretch" x:Uid="OKLabUI_StoreA" Click="{x:Bind OKStoreA}" />
                            <Button Grid.Column="1" HorizontalAlignment="Stretch" x:Uid="OKLabUI_SwapAB" Click="{x:Bind OKSwapAB}" />
                        </Grid>
                        <Button HorizontalAlignment="Stretch" x:Uid="OKLabUI_Undo" Click="{x:Bind OKUndo}" />
                    </local:SimpleStackPanel>
                    <local:SimpleStackPanel Width="260" Spacing="8" VerticalAlignment="Top"
                                            Visibility="{x:Bind HasOKContextTools, Mode=OneWay}">
					<ComboBox x:Uid="OKLabUI_Color" Visibility="{x:Bind OKMixerVisible, Mode=OneWay}" ItemsSource="{x:Bind OKColors}" SelectedIndex="{x:Bind OKColor, Mode=TwoWay}"  />
					<ComboBox x:Uid="OKLabUI_Slot" Visibility="{x:Bind OKSelectionVisible, Mode=OneWay}" ItemsSource="{x:Bind OKSlots}" SelectedIndex="{x:Bind OKSlot, Mode=TwoWay}"  />
					<TextBlock x:Uid="OKLabUI_PickSettingsHelp" Visibility="{x:Bind OKSelectionVisible, Mode=OneWay}" TextWrapping="Wrap" />
					<ComboBox x:Uid="OKLabUI_Curve" Visibility="{x:Bind OKCurveVisible, Mode=OneWay}" ItemsSource="{x:Bind OKCurves}" SelectedIndex="{x:Bind OKCurve, Mode=TwoWay}"  />
					<ComboBox x:Uid="OKLabUI_Wheel" Visibility="{x:Bind OKWheelVisible, Mode=OneWay}" ItemsSource="{x:Bind OKWheels}" SelectedIndex="{x:Bind OKWheel, Mode=TwoWay}"  />
					<Canvas Width="160" Height="160" Background="Transparent" Visibility="{x:Bind OKWheelVisible, Mode=OneWay}"
					        PointerPressed="{x:Bind OKWheelPressed}" PointerMoved="{x:Bind OKWheelMoved}" PointerReleased="{x:Bind OKWheelReleased}" PointerCanceled="{x:Bind OKWheelReleased}" PointerCaptureLost="{x:Bind OKWheelReleased}">
						<Image Source="{x:Bind OKWheelImage}" Width="160" Height="160" IsHitTestVisible="False" />
						<Ellipse Width="8" Height="8" Stroke="White" StrokeThickness="2" Fill="Black" Canvas.Left="{x:Bind OKWheelX, Mode=OneWay}" Canvas.Top="{x:Bind OKWheelY, Mode=OneWay}" IsHitTestVisible="False" />
					</Canvas>
					<TextBlock x:Uid="OKLabUI_WheelHelp" Visibility="{x:Bind OKWheelVisible, Mode=OneWay}" TextWrapping="Wrap" />
					<Canvas Width="240" Height="140" Background="{ThemeResource ControlFillColorDefaultBrush}" Visibility="{x:Bind OKCurveVisible, Mode=OneWay}"
					        PointerPressed="{x:Bind OKCurvePressed}" PointerMoved="{x:Bind OKCurveMoved}" PointerReleased="{x:Bind OKCurveReleased}" PointerCanceled="{x:Bind OKCurveReleased}" PointerCaptureLost="{x:Bind OKCurveReleased}">
						<Path Data="{x:Bind OKCurveGeometry, Mode=OneWay}" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" IsHitTestVisible="False" />
					</Canvas>
					<TextBlock x:Uid="OKLabUI_CurveHelp" Visibility="{x:Bind OKCurveVisible, Mode=OneWay}" TextWrapping="Wrap" />
					<StackPanel Spacing="6" Visibility="{x:Bind OKLutVisible, Mode=OneWay}">
						<Button x:Uid="OKLabUI_ImportLut" Click="{x:Bind OKImportLut}" />
						<Button x:Uid="OKLabUI_ExportLut" Click="{x:Bind OKExportLut}" />
						<TextBlock x:Uid="OKLabUI_LutExportHelp" TextWrapping="Wrap" />
						<Button x:Uid="OKLabUI_ClearLut" Click="{x:Bind OKClearLut}" />
						<TextBlock x:Uid="OKLabUI_LutRestart" TextWrapping="Wrap" />
						<TextBlock Text="{x:Bind OKStatus, Mode=OneWay}" TextWrapping="Wrap" />
					</StackPanel>

                    </local:SimpleStackPanel>
				<ItemsControl IsTabStop="False" VerticalAlignment="Top" HorizontalAlignment="Left"
				              ItemsSource="{x:Bind Groups, Mode=OneWay}">
					<ItemsControl.ItemContainerStyle>
						<Style TargetType="ContentPresenter">
							<Setter Property="VerticalAlignment" Value="Top" />
						</Style>
					</ItemsControl.ItemContainerStyle>
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<local:SimpleStackPanel Orientation="Horizontal" Spacing="24" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="local:EffectParameterGroupViewModel">
							<Grid HorizontalAlignment="Left" VerticalAlignment="Top"
							      Visibility="{x:Bind IsVisible, Mode=OneWay}">
								<Border Width="1"
								        Margin="-12,0,0,0"
								        HorizontalAlignment="Left"
								        Background="{ThemeResource ControlStrokeColorDefaultBrush}"
								        IsHitTestVisible="False"
								        Opacity="0.45"
								        Visibility="{x:Bind ShowLeadingSeparator, Mode=OneWay}" />
								<Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
								<TextBlock Margin="0,0,0,8" TextWrapping="WrapWholeWords"
								           FontWeight="SemiBold"
								           Text="{x:Bind Label, Mode=OneTime}"
								           Visibility="{x:Bind HasLabel, Mode=OneTime}" />
								<ItemsControl Grid.Row="1" IsTabStop="False"
								              ItemsSource="{x:Bind Params, Mode=OneTime}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<local:WrapPanel Orientation="Vertical" HorizontalSpacing="24" VerticalSpacing="8" />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="local:ScalingModeParameter">
											<Grid Width="260" Visibility="{x:Bind IsVisible, Mode=OneWay}">
												<ToggleButton x:Name="ParameterDisclosure" x:Load="{x:Bind IsDisclosure, Mode=OneTime}"
												              IsChecked="{x:Bind BooleanValue, Mode=TwoWay}"
												              IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
												              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
												              Background="Transparent" BorderThickness="0" Padding="0,8"
												              AutomationProperties.Name="{x:Bind Label, Mode=OneTime}">
													<ToolTipService.ToolTip>
														<ToolTip MaxWidth="360" Placement="Top">
															<TextBlock MaxWidth="328" Text="{x:Bind Tooltip, Mode=OneWay}" TextWrapping="Wrap" />
														</ToolTip>
													</ToolTipService.ToolTip>
													<StackPanel Orientation="Horizontal" Spacing="8">
														<FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="{x:Bind DisclosureGlyph, Mode=OneWay}" />
														<TextBlock Text="{x:Bind Label, Mode=OneTime}" />
													</StackPanel>
												</ToggleButton>
												<Grid x:Name="ParameterCheckBoxRow" ColumnSpacing="8" SizeChanged="ParameterCheckboxRow_SizeChanged" x:Load="{x:Bind IsCheckBox, Mode=OneTime}">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="Auto" />
														<ColumnDefinition Width="Auto" />
													</Grid.ColumnDefinitions>
													<CheckBox MinWidth="0"
												          IsChecked="{x:Bind BooleanValue, Mode=TwoWay}"
												          IsEnabled="{x:Bind IsEnabled, Mode=OneWay}">
													<TextBlock Text="{x:Bind Label, Mode=OneTime}"
													           TextWrapping="WrapWholeWords" AutomationProperties.HelpText="{x:Bind Tooltip, Mode=OneWay}">
														<ToolTipService.ToolTip>
															<ToolTip MaxWidth="360" Placement="Top">
																<StackPanel>
																<TextBlock MaxWidth="328" Text="{x:Bind Label, Mode=OneTime}" TextWrapping="Wrap" />
																<TextBlock MaxWidth="328" Text="{x:Bind Tooltip, Mode=OneWay}" TextWrapping="Wrap" />
																</StackPanel>
															</ToolTip>
														</ToolTipService.ToolTip>
													</TextBlock>
												</CheckBox>
													<CheckBox x:Name="ParameterCompanion" Grid.Column="1" MinWidth="0" x:Load="{x:Bind HasCompanion, Mode=OneTime}"
													          IsEnabled="{x:Bind Companion.IsEnabled, Mode=OneWay}"
													          IsChecked="{x:Bind Companion.BooleanValue, Mode=TwoWay}"
													          AutomationProperties.HelpText="{x:Bind Companion.Tooltip, Mode=OneWay}">
														<ToolTipService.ToolTip>
															<ToolTip MaxWidth="360" Placement="Top">
																<TextBlock MaxWidth="328" Text="{x:Bind Companion.Tooltip, Mode=OneWay}" TextWrapping="Wrap" />
															</ToolTip>
														</ToolTipService.ToolTip>
														<TextBlock Text="{x:Bind Companion.Label, Mode=OneTime}" TextWrapping="WrapWholeWords" />
													</CheckBox>
												</Grid>
												<local:SimpleStackPanel x:Name="ParameterNumericRow" x:Load="{x:Bind IsFloat, Mode=OneTime}">
													<Grid ColumnSpacing="4"
													      Visibility="{x:Bind HasNoDescriptionLine, Mode=OneTime}">
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="*" />
															<ColumnDefinition Width="60" />
														</Grid.ColumnDefinitions>
														<TextBlock Grid.Column="0"
														           VerticalAlignment="Center"
														           Text="{x:Bind Label, Mode=OneTime}"
														           TextWrapping="WrapWholeWords" AutomationProperties.HelpText="{x:Bind Tooltip, Mode=OneWay}">
															<ToolTipService.ToolTip>
																<ToolTip MaxWidth="360" Placement="Top">
																	<TextBlock MaxWidth="328" Text="{x:Bind Tooltip, Mode=OneWay}" TextWrapping="Wrap" />
																</ToolTip>
															</ToolTipService.ToolTip>
														</TextBlock>
														<TextBlock Grid.Column="1"
														           HorizontalAlignment="Right"
														           VerticalAlignment="Center"
														           Visibility="{x:Bind IsLegacyNumeric, Mode=OneTime}"
														           Text="{x:Bind ValueText, Mode=OneWay}" />
														<TextBox Grid.Column="1" MinWidth="0" Padding="4,2"
														         IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
														         Visibility="{x:Bind IsPreciseInput, Mode=OneTime}"
														         KeyDown="ParameterValue_KeyDown"
														         Text="{x:Bind EditableValue, Mode=TwoWay}" />
													</Grid>
													<Grid Visibility="{x:Bind HasDescriptionLine, Mode=OneTime}">
														<Grid.RowDefinitions>
															<RowDefinition Height="Auto" />
															<RowDefinition Height="Auto" />
														</Grid.RowDefinitions>
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="*" />
															<ColumnDefinition Width="60" />
														</Grid.ColumnDefinitions>
														<TextBlock Grid.Row="0"
														           Grid.Column="0"
														           VerticalAlignment="Center"
														           Text="{x:Bind PrimaryLabel, Mode=OneTime}"
														           TextWrapping="WrapWholeWords" AutomationProperties.HelpText="{x:Bind Tooltip, Mode=OneWay}">
															<ToolTipService.ToolTip>
																<ToolTip MaxWidth="360" Placement="Top">
																	<TextBlock MaxWidth="328" Text="{x:Bind Tooltip, Mode=OneWay}" TextWrapping="Wrap" />
																</ToolTip>
															</ToolTipService.ToolTip>
														</TextBlock>
														<TextBlock Grid.Row="0"
														           Grid.Column="1"
														           HorizontalAlignment="Right"
														           VerticalAlignment="Center"
														           Visibility="{x:Bind IsLegacyNumeric, Mode=OneTime}"
														           Text="{x:Bind ValueText, Mode=OneWay}" />
														<TextBox Grid.Row="0" Grid.Column="1" MinWidth="0" Padding="4,2"
														         IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
														         Visibility="{x:Bind IsPreciseInput, Mode=OneTime}"
														         KeyDown="ParameterValue_KeyDown"
														         Text="{x:Bind EditableValue, Mode=TwoWay}" />
														<TextBlock Grid.Row="1"
														           Grid.ColumnSpan="2"
														           Text="{x:Bind DescriptionLabel, Mode=OneTime}"
														           TextWrapping="WrapWholeWords" />
													</Grid>
									<TextBlock Text="{x:Bind InputError, Mode=OneWay}" TextWrapping="Wrap"
									           Visibility="{x:Bind HasInputError, Mode=OneWay}" />
									<Slider HorizontalAlignment="Stretch"
									        Loaded="ParameterSlider_Loaded"
									        Unloaded="ParameterSlider_Unloaded"
									        LostFocus="ParameterSlider_LostFocus"
									        DataContextChanged="ParameterSlider_DataContextChanged"
									        ValueChanged="ParameterSlider_ValueChanged"
									        KeyDown="ParameterSlider_KeyDown"
									        PointerWheelChanged="ParameterSlider_WheelChanged"
									        IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
									        IsThumbToolTipEnabled="False"
									        Maximum="{x:Bind SliderMaximum, Mode=OneTime}"
									        Minimum="{x:Bind SliderMinimum, Mode=OneTime}"
									        StepFrequency="{x:Bind SliderStep, Mode=OneTime}"
									        Value="{x:Bind SliderValue, Mode=TwoWay}" />
								</local:SimpleStackPanel>
								<local:SimpleStackPanel x:Name="ParameterChoiceRow" Spacing="4"
								                        x:Load="{x:Bind IsChoice, Mode=OneTime}">
									<TextBlock Text="{x:Bind Label, Mode=OneTime}"
									           TextWrapping="WrapWholeWords" AutomationProperties.HelpText="{x:Bind Tooltip, Mode=OneWay}">
										<ToolTipService.ToolTip>
											<ToolTip MaxWidth="360" Placement="Top">
												<TextBlock MaxWidth="328" Text="{x:Bind Tooltip, Mode=OneWay}" TextWrapping="Wrap" />
											</ToolTip>
										</ToolTipService.ToolTip>
									</TextBlock>
									<ComboBox HorizontalAlignment="Stretch"
									          PlaceholderText="—"
									          DropDownOpened="ParameterChoice_DropDownOpened"
									          DropDownClosed="ParameterChoice_DropDownClosed"
									          SelectionChanged="ParameterChoice_SelectionChanged"
									          IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
									          AutomationProperties.HelpText="{x:Bind Tooltip, Mode=OneWay}"
									          ItemsSource="{x:Bind Choices, Mode=OneWay}"
									          SelectedIndex="{x:Bind ChoiceIndex, Mode=TwoWay}">
										<ToolTipService.ToolTip>
											<ToolTip MaxWidth="360" Placement="Top">
												<TextBlock MaxWidth="328" Text="{x:Bind Tooltip, Mode=OneWay}" TextWrapping="Wrap" />
											</ToolTip>
										</ToolTipService.ToolTip>
									</ComboBox>
								</local:SimpleStackPanel>
							</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								</Grid>
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
                </local:SimpleStackPanel>
                    <Canvas IsHitTestVisible="False" Visibility="{x:Bind IsOKLab}"
                            Tag="{ThemeResource ControlStrokeColorDefaultBrush}" SizeChanged="ParameterColumns_SizeChanged" />
                </Grid>
            </Grid>
        </DataTemplate>
	</Page.Resources>
	<local:PageFrame x:Uid="ScalingModes_PageFrame">
		<local:PageFrame.HeaderAction>
			<local:SimpleStackPanel Orientation="Horizontal" Spacing="2">
				<local:SimpleStackPanel.Resources>
					<ResourceDictionary>
						<ResourceDictionary.ThemeDictionaries>
							<ResourceDictionary x:Key="Default">
								<StaticResource x:Key="ButtonBackground" ResourceKey="ControlFillColorDefaultBrush" />
								<StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ControlFillColorSecondaryBrush" />
								<StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ControlFillColorTertiaryBrush" />
								<StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="ControlFillColorDisabledBrush" />
							</ResourceDictionary>
							<ResourceDictionary x:Key="Light">
								<StaticResource x:Key="ButtonBackground" ResourceKey="ControlFillColorDefaultBrush" />
								<StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ControlFillColorSecondaryBrush" />
								<StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ControlFillColorTertiaryBrush" />
								<StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="ControlFillColorDisabledBrush" />
							</ResourceDictionary>
						</ResourceDictionary.ThemeDictionaries>
					</ResourceDictionary>
				</local:SimpleStackPanel.Resources>
				<Button x:Uid="ScalingModes_General_MoreOptions"
				        Style="{StaticResource ScalingModesHeaderButtonStyle}">
					<Button.Flyout>
						<MenuFlyout Placement="Bottom" ShouldConstrainToRootBounds="False">
							<MenuFlyoutItem x:Uid="ScalingModes_General_Import" Click="{x:Bind ViewModel.Import}">
								<MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutItem x:Uid="ScalingModes_General_Export" Click="{x:Bind ViewModel.Export}">
								<MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutItem x:Uid="ScalingModes_General_ConfigFolder" Click="OpenConfigFolderButton_Click">
								<MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutSeparator />
							<MenuFlyoutItem x:Uid="ScalingModes_General_Reset" Click="ResetScalingModesButton_Click">
								<MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;" /></MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
						</MenuFlyout>
					</Button.Flyout>
				</Button>
			</local:SimpleStackPanel>
		</local:PageFrame.HeaderAction>

		<local:SimpleStackPanel Padding="0,4,0,0"
		                        HorizontalAlignment="Stretch"
		                        ChildrenTransitions="{StaticResource SettingsCardsAnimations}"
		                        Orientation="Vertical">
			<muxc:InfoBar x:Uid="ScalingModes_DuplicateNames" IsClosable="False"
			              IsOpen="{x:Bind ViewModel.HasDuplicateNames, Mode=OneWay}" Severity="Warning" />
			<muxc:InfoBar x:Name="IssueTargetNotice" IsOpen="False" IsClosable="True" Severity="Informational" />
			<!--  Padding 是为了缓解一个动画 bug  -->
			<ListView x:Name="ScalingModeList" Padding="0,0,0,44"
			          ItemsSource="{x:Bind ViewModel.ScalingModes, Mode=OneTime}"
			          SelectionMode="None"
			          TabNavigation="Local">
				<ListView.ItemContainerTransitions>
					<TransitionCollection>
						<ContentThemeTransition />
						<RepositionThemeTransition IsStaggeringEnabled="False" />
					</TransitionCollection>
				</ListView.ItemContainerTransitions>
				<ListView.Resources>
					<Style TargetType="ListViewItem">
						<Setter Property="Margin" Value="0,0,0,2" />
						<Setter Property="Padding" Value="0" />
						<Setter Property="MinHeight" Value="0" />
						<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						<Setter Property="IsTabStop" Value="False" />
					</Style>
				</ListView.Resources>
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="local:ScalingModeItem">
						<local:SettingsExpander Description="{x:Bind Description, Mode=OneWay}"
						                        Header="{x:Bind Name, Mode=OneWay}"
						                        IsExpanded="{x:Bind IsInitialExpanded, Mode=OneTime}">
							<local:SimpleStackPanel Orientation="Horizontal"
							                        Spacing="4">
								<local:SimpleStackPanel.Resources>
									<Style BasedOn="{StaticResource DefaultButtonStyle}"
									       TargetType="Button">
										<Setter Property="Padding" Value="10" />
									</Style>
									<Style TargetType="FontIcon">
										<Setter Property="FontSize" Value="15" />
									</Style>
								</local:SimpleStackPanel.Resources>
								<Button x:Uid="ScalingModes_Delete"
								        Click="RemoveScalingModeButton_Click"
								        Tag="{x:Bind}">
									<Button.Content>
										<FontIcon Glyph="&#xE74D;" />
									</Button.Content>
									<FlyoutBase.AttachedFlyout>
										<Flyout>
											<local:SimpleStackPanel MaxWidth="280">
												<TextBlock x:Uid="ScalingModes_DeleteFlyout_Title"
												           Margin="0,0,0,15"
												           FontWeight="SemiBold"
												           TextWrapping="WrapWholeWords" />
												<local:SimpleStackPanel Margin="0,0,0,10"
												                        Spacing="8">
													<TextBlock x:Uid="ScalingModes_DeleteFlyout_Description" />
													<ListView ItemsSource="{x:Bind LinkedProfiles, Mode=OneTime}"
													          SelectionMode="None">
														<ListView.ItemsPanel>
															<ItemsPanelTemplate>
																<local:SimpleStackPanel Spacing="4" />
															</ItemsPanelTemplate>
														</ListView.ItemsPanel>
														<ListView.Resources>
															<Style TargetType="ListViewItem">
																<Setter Property="Margin" Value="0" />
																<Setter Property="Padding" Value="0" />
																<Setter Property="MinHeight" Value="0" />
																<Setter Property="HorizontalContentAlignment" Value="Stretch" />
																<Setter Property="IsTabStop" Value="False" />
															</Style>
														</ListView.Resources>
														<ListView.ItemTemplate>
															<DataTemplate x:DataType="x:String">
																<TextBlock local:TextBlockHelper.IsAutoTooltipEnabled="True"
																           FontStyle="Italic"
																           Text="{x:Bind Mode=OneTime}"
																           TextTrimming="CharacterEllipsis" />
															</DataTemplate>
														</ListView.ItemTemplate>
													</ListView>
												</local:SimpleStackPanel>
												<Button HorizontalAlignment="Right"
												        Click="{x:Bind Remove}">
													<Button.Resources>
														<ResourceDictionary>
															<StaticResource x:Key="ButtonBackground" ResourceKey="DeleteButtonBackgroundBrush" />
															<StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="DeleteButtonBackgroundPointerOverBrush" />
															<StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="DeleteButtonBackgroundPressedBrush" />
															<StaticResource x:Key="ButtonForeground" ResourceKey="DeleteButtonForegroundBrush" />
															<StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="DeleteButtonForegroundBrush" />
															<StaticResource x:Key="ButtonForegroundPressed" ResourceKey="DeleteButtonForegroundPressedBrush" />
														</ResourceDictionary>
													</Button.Resources>
													<Button.Content>
														<local:SimpleStackPanel Orientation="Horizontal" Spacing="8">
															<FontIcon VerticalAlignment="Center"
															          FontSize="{StaticResource StandardIconSize}"
															          Glyph="&#xE74D;" />
															<TextBlock x:Uid="ScalingModes_DeleteFlyout_Delete"
															           VerticalAlignment="Center" />
														</local:SimpleStackPanel>
													</Button.Content>
												</Button>
											</local:SimpleStackPanel>
										</Flyout>
									</FlyoutBase.AttachedFlyout>
								</Button>
								<Button x:Uid="ScalingModes_Rename"
								        DataContextChanged="ScalingModeRenameButton_DataContextChanged"
								        Loaded="ScalingModeRenameButton_Loaded"
								        Tag="{x:Bind}">
									<Button.Content>
										<FontIcon Glyph="&#xE8AC;" />
									</Button.Content>
									<Button.Flyout>
										<Flyout Opening="{x:Bind RenameFlyout_Opening}">
											<local:SimpleStackPanel>
											<TextBlock x:Uid="ScalingModes_RenameFlyout_Title" />
											<TextBox Width="280"
											         Height="32"
											         Margin="0,8,0,20"
											         KeyDown="{x:Bind RenameTextBox_KeyDown}"
											         Loaded="RenameTextBox_Loaded"
											         SelectionStart="{x:Bind RenameTextBoxSelectionStart, Mode=OneWay}"
											         Text="{x:Bind RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
													<TextBox.ContextFlyout>
														<local:TextMenuFlyout />
													</TextBox.ContextFlyout>
												</TextBox>
												<TextBlock MaxWidth="280" Margin="0,0,0,12" TextWrapping="Wrap"
												           Text="{x:Bind RenameProblem, Mode=OneWay}"
												           Visibility="{x:Bind HasRenameProblem, Mode=OneWay}" />
												<Button x:Uid="ScalingModes_RenameFlyout_OK"
												        MinWidth="80"
												        HorizontalAlignment="Right"
												        Click="{x:Bind RenameButton_Click}"
												        IsEnabled="{x:Bind IsRenameButtonEnabled, Mode=OneWay}"
												        Style="{StaticResource AccentButtonStyle}" />
											</local:SimpleStackPanel>
										</Flyout>
									</Button.Flyout>
								</Button>
								<Button x:Uid="ScalingModes_Duplicate"
								        Click="{x:Bind Duplicate}">
									<Button.Content>
										<FontIcon Glyph="&#xE8C8;" />
									</Button.Content>
								</Button>
								<Grid x:Uid="ScalingModes_DragHandle"
								      Width="36"
								      Height="36"
								      Background="Transparent"
								      IsHitTestVisible="{x:Bind CanDrag, Mode=OneWay}"
								      PointerCanceled="ReorderHandle_PointerCanceled"
								      PointerCaptureLost="ReorderHandle_PointerCaptureLost"
								      PointerMoved="ReorderHandle_PointerMoved"
								      PointerPressed="ReorderHandle_PointerPressed"
								      PointerReleased="ReorderHandle_PointerReleased"
								      Tag="{x:Bind}">
									<FontIcon IsHitTestVisible="False"
									          Glyph="&#xE700;"
									          Visibility="{x:Bind CanDrag, Mode=OneWay}" />
								</Grid>
							</local:SimpleStackPanel>
							<local:SettingsExpander.Items>
							<ListView x:Name="IssueEffectList" ItemsSource="{x:Bind Effects, Mode=OneTime}"
								          SelectionMode="None"
								          TabNavigation="Local">
									<ListView.ItemContainerTransitions>
										<TransitionCollection>
										<ContentThemeTransition />
										<RepositionThemeTransition IsStaggeringEnabled="False" />
										</TransitionCollection>
									</ListView.ItemContainerTransitions>
									<ListView.ItemsPanel>
										<ItemsPanelTemplate>
											<!--  SimpleStackPanel 不支持拖放  -->
											<StackPanel ChildrenTransitions="{StaticResource SettingsCardsAnimations}"
											            Orientation="Vertical" />
										</ItemsPanelTemplate>
									</ListView.ItemsPanel>
									<ListView.Resources>
										<Style TargetType="ListViewItem">
											<Setter Property="Margin" Value="0" />
											<Setter Property="Padding" Value="0" />
											<Setter Property="MinHeight" Value="0" />
											<Setter Property="HorizontalContentAlignment" Value="Stretch" />
											<Setter Property="IsTabStop" Value="False" />
										</Style>
									</ListView.Resources>
									<ListView.ItemTemplate>
										<DataTemplate x:DataType="local:ScalingModeEffectItem">
											<local:SettingsCard Header="{x:Bind Name}"
											                    Description="{x:Bind IssueDescription}"
											                    Loaded="EffectSettingsCard_Loaded"
											                    Style="{StaticResource DefaultSettingsExpanderItemStyle}">
												<local:SimpleStackPanel Orientation="Horizontal">
													<local:SimpleStackPanel.Resources>
														<Style BasedOn="{StaticResource DefaultButtonStyle}"
														       TargetType="Button">
															<Setter Property="Padding" Value="10" />
														</Style>
														<Style TargetType="FontIcon">
															<Setter Property="FontSize" Value="15" />
														</Style>
													</local:SimpleStackPanel.Resources>
													<Button x:Uid="ScalingModes_Scale"
													        Margin="0,0,4,0"
													        Visibility="{x:Bind CanScale}">
														<Button.Content>
															<FontIcon Glyph="&#xE740;" />
														</Button.Content>
														<Button.Flyout>
															<Flyout>
																<local:SimpleStackPanel Width="260"
																                        Margin="0,0,0,4">
																	<local:SimpleStackPanel.Resources>
																		<Style TargetType="muxc:NumberBox">
																			<Setter Property="HorizontalAlignment" Value="Stretch" />
																			<Setter Property="SpinButtonPlacementMode" Value="Inline" />
																			<!--  修复有时取消禁用后文字依然为灰色的问题  -->
																			<Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
																		</Style>
																	</local:SimpleStackPanel.Resources>
																	<local:SimpleStackPanel Spacing="8">
																		<TextBlock x:Uid="ScalingModes_ScaleFlyout_Type" />
																		<!--  硬编码会导致崩溃！  -->
																		<!--  https://github.com/microsoft/microsoft-ui-xaml/issues/3612  -->
																		<ComboBox HorizontalAlignment="Stretch"
																		          DropDownOpened="ComboBox_DropDownOpened"
																		          ItemsSource="{x:Bind ScalingTypes, Mode=OneWay}"
																		          SelectedIndex="{x:Bind ScalingType, Mode=TwoWay}">
																			<ComboBox.Resources>
																				<Style x:Key="Description"
																				       TargetType="TextBlock">
																					<Setter Property="FontSize" Value="12" />
																					<Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
																					<Setter Property="TextWrapping" Value="WrapWholeWords" />
																				</Style>
																			</ComboBox.Resources>
																			<ComboBox.ItemTemplate>
																				<DataTemplate x:DataType="local:ScalingTypeItem">
																					<local:SimpleStackPanel>
																						<TextBlock HorizontalAlignment="Left"
																						           Text="{x:Bind Name, Mode=OneTime}" />
																						<TextBlock HorizontalAlignment="Left"
																						           Style="{StaticResource Description}"
																						           Text="{x:Bind Desc, Mode=OneTime}" />
																					</local:SimpleStackPanel>
																				</DataTemplate>
																			</ComboBox.ItemTemplate>
																		</ComboBox>
																	</local:SimpleStackPanel>
																	<local:SimpleStackPanel Margin="0,15,0,0"
																	                        Spacing="15"
																	                        Visibility="{x:Bind IsShowScaleFactors, Mode=OneWay}">
																		<local:SimpleStackPanel.Resources>
																			<Style TargetType="muxc:NumberBox">
																				<Setter Property="HorizontalAlignment" Value="Stretch" />
																				<Setter Property="SmallChange" Value="0.1" />
																				<Setter Property="LargeChange" Value="0.5" />
																				<Setter Property="SpinButtonPlacementMode" Value="Inline" />
																			</Style>
																		</local:SimpleStackPanel.Resources>
																		<local:SimpleStackPanel Spacing="8">
																			<TextBlock x:Uid="ScalingModes_ScaleFlyout_WidthFactor" />
																			<muxc:NumberBox Loaded="NumberBox_Loaded"
																			                NumberFormatter="{x:Bind local:App.DoubleFormatter, Mode=OneTime}"
																			                Value="{x:Bind ScaleFactorX, Mode=TwoWay}" />
																		</local:SimpleStackPanel>
																		<local:SimpleStackPanel Spacing="8">
																			<TextBlock x:Uid="ScalingModes_ScaleFlyout_HeightFactor" />
																			<muxc:NumberBox Loaded="NumberBox_Loaded"
																			                NumberFormatter="{x:Bind local:App.DoubleFormatter, Mode=OneTime}"
																			                Value="{x:Bind ScaleFactorY, Mode=TwoWay}" />
																		</local:SimpleStackPanel>
																	</local:SimpleStackPanel>
																	<local:SimpleStackPanel Margin="0,15,0,0"
																	                        Spacing="15"
																	                        Visibility="{x:Bind IsShowScalingPixels, Mode=OneWay}">
																		<local:SimpleStackPanel.Resources>
																			<Style TargetType="muxc:NumberBox">
																				<Setter Property="HorizontalAlignment" Value="Stretch" />
																				<Setter Property="SmallChange" Value="1" />
																				<Setter Property="LargeChange" Value="10" />
																				<Setter Property="SpinButtonPlacementMode" Value="Inline" />
																			</Style>
																		</local:SimpleStackPanel.Resources>
																		<local:SimpleStackPanel Spacing="8">
																			<TextBlock x:Uid="ScalingModes_ScaleFlyout_WidthPixels" />
																			<muxc:NumberBox Loaded="NumberBox_Loaded"
																			                NumberFormatter="{x:Bind local:App.DoubleFormatter, Mode=OneTime}"
																			                Value="{x:Bind ScalingPixelsX, Mode=TwoWay}" />
																		</local:SimpleStackPanel>
																		<local:SimpleStackPanel Spacing="8">
																			<TextBlock x:Uid="ScalingModes_ScaleFlyout_HeightPixels" />
																			<muxc:NumberBox Loaded="NumberBox_Loaded"
																			                NumberFormatter="{x:Bind local:App.DoubleFormatter, Mode=OneTime}"
																			                Value="{x:Bind ScalingPixelsY, Mode=TwoWay}" />
																		</local:SimpleStackPanel>
																	</local:SimpleStackPanel>
																</local:SimpleStackPanel>
															</Flyout>
														</Button.Flyout>
													</Button>
													<Button x:Uid="ScalingModes_Parameters"
													        Loaded="ParameterAnchor_Loaded" Unloaded="ParameterAnchor_Unloaded"
													        Margin="0,0,4,0"
													        Visibility="{x:Bind HasParameters}">
														<Button.Content>
															<FontIcon Glyph="&#xE9E9;" />
														</Button.Content>
													<Button.Flyout>
														<Flyout Opening="EffectParametersFlyout_Opening" ShouldConstrainToRootBounds="False"
														        FlyoutPresenterStyle="{StaticResource EffectParametersPresenterStyle}"
														        Opened="EffectParametersFlyout_Opened" Closing="EffectParametersFlyout_Closing"
														        Closed="EffectParametersFlyout_Closed">
															<ContentControl Content="{x:Bind Parameters, Mode=OneTime}"
															                ContentTemplate="{StaticResource EffectParametersFlyout}"
															                IsTabStop="False" />
														</Flyout>
													</Button.Flyout>
													</Button>
													<Button x:Uid="ScalingModes_Delete"
													        Click="{x:Bind Remove}">
														<Button.Content>
															<FontIcon Glyph="&#xE74D;" />
														</Button.Content>
													</Button>
													<Grid x:Uid="ScalingModes_DragHandle"
													      Width="36"
													      Height="36"
													      Margin="4,0,0,0"
													      Background="Transparent"
													      IsHitTestVisible="{x:Bind CanDrag, Mode=OneWay}"
													      PointerCanceled="ReorderHandle_PointerCanceled"
													      PointerCaptureLost="ReorderHandle_PointerCaptureLost"
													      PointerMoved="ReorderHandle_PointerMoved"
													      PointerPressed="ReorderHandle_PointerPressed"
													      PointerReleased="ReorderHandle_PointerReleased"
													      Tag="{x:Bind}">
														<FontIcon IsHitTestVisible="False"
														          Glyph="&#xE700;"
														          Visibility="{x:Bind CanDrag, Mode=OneWay}" />
													</Grid>
												</local:SimpleStackPanel>
											</local:SettingsCard>
										</DataTemplate>
									</ListView.ItemTemplate>
								</ListView>
							</local:SettingsExpander.Items>
							<local:SettingsExpander.ItemsHeader>
								<local:SimpleStackPanel>
									<muxc:InfoBar x:Uid="ScalingModes_NameConflict" IsClosable="False"
									              IsOpen="{x:Bind HasNameConflict, Mode=OneWay}" Severity="Warning" />
									<muxc:InfoBar x:Uid="ScalingModes_HasUnkownEffects"
									              MinHeight="0"
									              Margin="0,0,0,-4"
									              BorderThickness="0,0,0,0"
									              CornerRadius="0"
									              IsClosable="False"
									              IsOpen="{x:Bind HasUnkownEffects, Mode=OneWay}"
									              Severity="Warning" />
								</local:SimpleStackPanel>
							</local:SettingsExpander.ItemsHeader>
							<local:SettingsExpander.ItemsFooter>
								<local:SettingsCard Style="{StaticResource DefaultSettingsExpanderItemStyle}">
									<local:SettingsCard.Description>
										<local:SimpleStackPanel Margin="-40,0,0,-20">
											<TextBlock x:Uid="ScalingModes_DragToReorder"
											           Visibility="{x:Bind CanReorderEffects, Mode=OneWay}" />
										</local:SimpleStackPanel>
									</local:SettingsCard.Description>
									<Button x:Name="AddEffectButton"
									        Padding="10,8"
									        Background="Transparent"
									        BorderBrush="Transparent"
									        Click="AddEffectButton_Click"
									        Tag="{x:Bind}">
										<Button.Resources>
											<ResourceDictionary>
												<ResourceDictionary.ThemeDictionaries>
													<ResourceDictionary x:Key="Default" />
													<ResourceDictionary x:Key="HighContrast" />
													<ResourceDictionary x:Key="Light">
														<StaticResource x:Key="ButtonBackground"
														                ResourceKey="SubtleFillColorTransparentBrush" />
														<StaticResource x:Key="ButtonBackgroundPointerOver"
														                ResourceKey="SubtleFillColorSecondaryBrush" />
														<StaticResource x:Key="ButtonBackgroundPressed"
														                ResourceKey="SubtleFillColorTertiaryBrush" />
														<StaticResource x:Key="ButtonBorderBrush"
														                ResourceKey="ControlFillColorTransparentBrush" />
														<StaticResource x:Key="ButtonBorderBrushPointerOver"
														                ResourceKey="ControlFillColorTransparentBrush" />
														<StaticResource x:Key="ButtonBorderBrushPressed"
														                ResourceKey="ControlFillColorTransparentBrush" />
													</ResourceDictionary>
												</ResourceDictionary.ThemeDictionaries>
											</ResourceDictionary>
										</Button.Resources>
										<local:SimpleStackPanel VerticalAlignment="Center"
										                        Orientation="Horizontal"
										                        Spacing="8">
											<FontIcon FontSize="{StaticResource StandardIconSize}"
											          Glyph="&#xE710;" />
											<TextBlock x:Uid="ScalingModes_AddEffect"
											           Margin="0,-1,0,0" />
										</local:SimpleStackPanel>
									</Button>
								</local:SettingsCard>
							</local:SettingsExpander.ItemsFooter>
						</local:SettingsExpander>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
			<!-- Positive extent keeps the footer arranged by SimpleStackPanel. -->
			<local:SimpleStackPanel>
				<Button HorizontalAlignment="Right"
				        Click="NewScalingModeButton_Click"
				        Style="{StaticResource AccentButtonStyle}">
					<Button.Content>
						<local:SimpleStackPanel Orientation="Horizontal"
						                        Spacing="8">
							<FontIcon FontSize="{StaticResource StandardIconSize}"
							          Glyph="&#xE710;" />
							<TextBlock x:Uid="ScalingModes_NewScalingMode" />
						</local:SimpleStackPanel>
					</Button.Content>
				</Button>
			</local:SimpleStackPanel>
		</local:SimpleStackPanel>
	</local:PageFrame>
</Page>
